<?xml version="1.0" encoding="utf-8"?>
<!-- Many internet radio stations (Radio Browser, Icecast) only stream over plain http://.
     Android blocks cleartext by default, which made those stations silently fail to play. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
