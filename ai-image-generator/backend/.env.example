# Application
APP_NAME=AI Image Generator
DEBUG=False
VERSION=1.0.0

# Server
API_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_image_generator
DATABASE_ECHO=False

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SUPER_ADMIN_SESSION_EXPIRE_HOURS=12

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET_NAME=ai-image-generator-images
AWS_REGION=us-east-1

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-chars-min
VAULT_ENCRYPTION_ENABLED=True

# Safety
SAFETY_CHECKS_ENABLED=True
PROMPT_SAFETY_THRESHOLD=0.7
OUTPUT_SAFETY_THRESHOLD=0.8
AUTO_BLOCK_SEVERITY_THRESHOLD=8

# Features
WEBGPU_LOCAL_MODE_ENABLED=True
CREATOR_MODE_ENABLED=True
MODERATION_ENABLED=True

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Admin Security
REQUIRE_2FA_FOR_ADMIN=True
IP_RESTRICTION_ENABLED=True
SUSPICIOUS_ACTIVITY_DETECTION=True
