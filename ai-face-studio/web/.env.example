# Client-side DEMO gate only — see SPEC §15 and README "What's real vs. mocked".
# This is NOT a real auth secret: Next.js inlines NEXT_PUBLIC_* values into the browser bundle,
# so anyone can read it. It exists only so the Owner dashboard has something to compare against
# locally. Never put a real secret here; the real OWNER_ACCESS_KEY (SPEC §15.1) belongs server-side
# only, in a secret manager, never in a committed .env file.
NEXT_PUBLIC_OWNER_EMAIL=owner@example.com
