{
  "name": "ai-face-studio-web",
  "version": "0.1.0",
  "private": true,
  "description": "AI Face Studio: Next.js app shell with a mock AI provider (see ../README.md for scope).",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "build:capacitor": "BUILD_TARGET=capacitor next build",
    "cap:sync": "npm run build:capacitor && npx cap sync android",
    "cap:assets": "npx capacitor-assets generate --android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.18"
  }
}
