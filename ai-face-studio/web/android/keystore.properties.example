# Copy this file to keystore.properties (same folder, android/keystore.properties) and fill in
# real values. keystore.properties is git-ignored — never commit the copy with real passwords in it,
# and never commit the .jks/.keystore file itself. See ../../README.md "Release signing" for how to
# generate the keystore this points at.
storeFile=/absolute/path/to/ai-face-studio-release.jks
storePassword=changeit
keyAlias=aifacestudio
keyPassword=changeit
