# Copy to .env and fill in every value.
# Generate RS256 key pair:
#   openssl genrsa -out jwt-private.pem 4096
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
#   export JWT_PRIVATE_KEY="$(cat jwt-private.pem)"
#   export JWT_PUBLIC_KEY="$(cat jwt-public.pem)"
# Generate refresh secret: openssl rand -hex 64
# Never commit a filled-in .env file or any .pem key files.
# ─── General ──────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ─── Database ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=ananvi
DB_PASS=
DB_NAME=ananvi_studio
DB_SSL=false

# ─── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=

# ─── JWT (RS256) ───────────────────────────────────────
# Multi-line PEM — wrap in double quotes in .env, or set via export (see header)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...paste private key...
-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...paste public key...
-----END PUBLIC KEY-----"
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-string

# ─── S3 / MinIO ──────────────────────────────────────
S3_REGION=us-east-1
S3_BUCKET=ananvi-studio
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH=true

# ─── Dodo Payments ───────────────────────────────────
DODO_API_KEY=dodo_test_xxxxxxxxxxxx
DODO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ─── Temp / FFmpeg ───────────────────────────────────
TMP_DIR=/tmp/ananvi
