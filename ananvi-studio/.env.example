# Copy to .env and fill in every value. Generate JWT secrets with: openssl rand -hex 64
# Never commit a filled-in .env file.
# ─── General ──────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ─── Database ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=ananvi
DB_PASS=
DB_NAME=ananvi_studio
DB_SSL=false

# ─── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-string

# ─── S3 / MinIO ──────────────────────────────────────
S3_REGION=us-east-1
S3_BUCKET=ananvi-studio
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH=true

# ─── Dodo Payments ───────────────────────────────────
DODO_API_KEY=dodo_test_xxxxxxxxxxxx
DODO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ─── Temp / FFmpeg ───────────────────────────────────
TMP_DIR=/tmp/ananvi
