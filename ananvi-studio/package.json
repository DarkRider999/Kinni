{
  "name": "ananvi-studio",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run start:dev -w @ananvi/api",
    "dev:web": "npm run dev -w @ananvi/web",
    "build": "npm run build -w @ananvi/shared && npm run build -w @ananvi/api && npm run build -w @ananvi/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @ananvi/api",
    "test:e2e": "npm run test:e2e -w @ananvi/web",
    "test:perf": "k6 run k6/smoke.js"
  }
}
