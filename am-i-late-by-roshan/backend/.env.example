# ---------------------------------------------------------------- core
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/am_i_late
# Leave empty to use an in-process event bus (single instance). Set for multi-instance fan-out.
REDIS_URL=redis://localhost:6379
# URL of the FastAPI service, or "local" to use the built-in fallback heuristics only.
AI_SERVICE_URL=http://localhost:8000
# REQUIRED in production: long random string used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Apply database/migrations automatically on start (default true).
MIGRATE_ON_START=true

# ---------------------------------------------------------------- maps (free by default)
# osrm (free, no key) | google | mapbox | haversine (offline estimate)
MAP_PROVIDER=osrm
# Public demo server is fine for testing; self-host osrm-backend with a GCC extract for production.
OSRM_BASE_URL=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
# Free OpenStreetMap services for place search, speed limits and car parks.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=AmILateByRoshan/1.0 (contact: you@example.com)
EXTERNAL_HTTP_TIMEOUT_MS=6000

# ---------------------------------------------------------------- weather & events
# Empty = Open-Meteo (free, no key). Set to use OpenWeather instead.
OPENWEATHER_API_KEY=
# Optional JSON feed of events: [{name, venue, lat, lng, starts_at, ends_at, expected_attendance}]
EVENTS_API_URL=

# ---------------------------------------------------------------- push notifications (optional)
# Without these, alerts are delivered in-app (live stream + inbox). With them, via FCM (Android + iOS).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste the service-account private key with literal \n for newlines.
FCM_PRIVATE_KEY=
# APNs extension point (see src/services/push_notification_service.ts); not needed when using FCM.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.roshan.amILate
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false

# ---------------------------------------------------------------- assistant (optional)
# Empty = built-in rule-based assistant (free). Set an Anthropic API key to use Claude.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# ---------------------------------------------------------------- behaviour
# Default "traffic got worse" threshold for new users (minutes).
EARLY_WARNING_ETA_INCREASE_MINUTES=10
CRON_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
# Comma-separated list, or * for any origin.
CORS_ORIGINS=*
LOG_LEVEL=info
