// ExpertPrompter data model (PostgreSQL)
// Run `npx prisma migrate dev --name init` to create the tables.

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: pooled connection used by the app at runtime (on Supabase,
//   the transaction pooler on port 6543 with ?pgbouncer=true).
// DIRECT_URL:   session/direct connection used by `prisma migrate`.
// Locally both can point at the same database.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Task categories produced by CategoryDetectionService.
enum Category {
  WRITING
  BUSINESS
  CODING
  IMAGE
  VIDEO
  MUSIC
  MARKETING
  EDUCATION
  DATA_ANALYSIS
  RESEARCH
  GENERAL_WRITING
}

/// Voice/structure presets the user can pick in the UI.
enum PromptStyle {
  PROFESSIONAL
  CREATIVE
  TECHNICAL
  EDUCATIONAL
}

/// Who owns a template: shipped with the app or created by a user.
enum TemplateSource {
  SYSTEM
  USER
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  /// Optional sign-in name (lower-case), e.g. for a shared account with no personal email.
  username             String?    @unique
  /// Unlimited free access. Set only by an admin directly in the database; never via sign-up.
  isMaster             Boolean    @default(false)
  /// Null for accounts created through Google/Facebook/GitHub only.
  passwordHash         String?
  name                 String?
  image                String?
  /// Set when an OAuth provider confirmed the address. Master access requires it.
  emailVerified        DateTime?
  /// Generations used on the free plan (see FREE_RUN_LIMIT).
  freeRunsUsed         Int        @default(0)
  stripeCustomerId     String?    @unique
  stripeSubscriptionId String?
  /// Mirrors Stripe: active, trialing, past_due, canceled, ...
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  prompts              Prompt[]
  templates            Template[]
  accounts             Account[]
}

/// A linked sign-in provider (Google, Facebook, GitHub) for a user.
model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Prompt {
  id               String      @id @default(cuid())
  userId           String?
  user             User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawInput         String      @db.Text
  detectedCategory Category
  promptStyle      PromptStyle @default(PROFESSIONAL)
  /// The constraint options used (tone, length, format, audience, language).
  options          Json        @default("{}")
  generatedPrompt  String      @db.Text
  /// Ordered list of recommended tool names, e.g. ["ChatGPT", "Claude"].
  recommendedTools String[]
  title            String?     @db.VarChar(160)
  isFavorite       Boolean     @default(false)
  createdAt        DateTime    @default(now())

  // History is always listed per user, newest first.
  @@index([userId, createdAt(sort: Desc)])
  @@index([detectedCategory])
}

model Template {
  id            String         @id @default(cuid())
  /// Stable key, e.g. "writing.resignation-letter". Unique so the seed is idempotent.
  key           String         @unique
  name          String
  category      Category
  /// { sections: string[], defaultFormat: string, qualityChecks: string[] }
  baseStructure Json
  createdBy     TemplateSource @default(SYSTEM)
  ownerId       String?
  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@index([category])
  @@index([ownerId])
}
