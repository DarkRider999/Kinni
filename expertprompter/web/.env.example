# Copy to .env (used by Next.js and Prisma) and adjust.
# Without DATABASE_URL the app runs in guest-only mode (generation works; accounts/history are disabled).

# Local Postgres from ../docker-compose.yml
DATABASE_URL="postgresql://expertprompter:expertprompter@localhost:5432/expertprompter?schema=public"
DIRECT_URL="postgresql://expertprompter:expertprompter@localhost:5432/expertprompter?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Optional: only if the API is hosted on a different origin.
# NEXT_PUBLIC_API_URL=

# Public URL of the app (used for OAuth callbacks and Stripe return links)
APP_URL=http://localhost:3000

# Owner account(s) with unlimited free access. Only applies once the email is
# verified by signing in with Google/Facebook/GitHub.
MASTER_EMAILS=you@example.com

# Social sign-in: each provider appears once both values are set.
# Callback URL to register: <APP_URL>/api/auth/oauth/<google|facebook|github>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe (Premium, $10/month). Webhook endpoint: <APP_URL>/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: use a Price from your Stripe dashboard instead of the built-in $10/month
STRIPE_PRICE_ID=

# AI photo descriptions ("recreate this photo"). Without a key, photos are only listed.
# Gemini is used when its key is set (free tier at https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-flash-latest)
GEMINI_MODEL=
# Or Claude (pay-as-you-go): used when no Gemini key is set
ANTHROPIC_API_KEY=
# Optional: Claude model (default claude-opus-5; e.g. claude-haiku-4-5 is cheaper)
VISION_MODEL=
# Optional: force a provider when both keys are set: gemini | anthropic
VISION_PROVIDER=

# Optional: shown on the Privacy and Terms pages
NEXT_PUBLIC_CONTACT_EMAIL=
